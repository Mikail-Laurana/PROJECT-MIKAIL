# .env.production - Production Environment Variables
# FILE INI UNTUK PRODUCTION - JANGAN COMMIT KE VERSION CONTROL!

# Database Configuration
DB_HOST=localhost
DB_NAME=sekolah_production
DB_USERNAME=sekolah_user
DB_PASSWORD=super_secure_password_change_this
DB_CHARSET=utf8mb4

# Application Settings
APP_ENV=production
APP_DEBUG=false
APP_URL=https://sekolah.domain.com
APP_NAME="SMA Negeri 1 Contoh"
APP_TIMEZONE=Asia/Jakarta

# Security (WAJIB DIGANTI DENGAN VALUE YANG AMAN!)
JWT_SECRET=production-super-secret-jwt-key-min-32-chars
ENCRYPTION_KEY=32-char-production-encryption-key
SESSION_LIFETIME=7200
CSRF_TOKEN_EXPIRE=3600

# Email Configuration (untuk contact form, notifications)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=noreply@sekolah.com
MAIL_PASSWORD=secure_app_password_here
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@sekolah.com
MAIL_FROM_NAME="SMA Negeri 1 Contoh"

# File Upload (production limits)
MAX_FILE_SIZE=10485760
UPLOAD_PATH=/var/www/uploads/
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,pdf,doc,docx

# Rate Limiting (stricter for production)
RATE_LIMIT_LOGIN=3
RATE_LIMIT_CONTACT=2
RATE_LIMIT_WINDOW=600

# Logging
LOG_LEVEL=error
LOG_PATH=/var/www/logs/
LOG_MAX_FILES=90

# Cache Settings (enable for production)
CACHE_ENABLED=true
CACHE_DRIVER=file
CACHE_LIFETIME=3600